Mods: {
	LaSangreMod: {
		Items: {
			LaSangreWeapon: {
				DisplayName: La Sangre
				Tooltip:
					'''
					Deal melee damage to gain [c/c2003a:Hardblood]. Gain double 
					when using {$Mods.LaSangreMod.Items.LaSangreWeapon.DisplayName}. At maximum [c/c2003a:Hardblood], <right> 
					to spend all [c/c2003a:Hardblood] to temporarily enhance {$Mods.LaSangreMod.Items.LaSangreWeapon.DisplayName}
					into {$Mods.LaSangreMod.Items.AscendantWeapon.DisplayName} for {0} seconds.
					Steals enemy life on hit.
					Build momentumn to increase attack power.
					'''
				CurrentHardblood: "[c/c2003a:HARDBLOOD: {0}% ({1} / {2})]"
			}

			AscendantWeapon: {
				DisplayName: Ascendant La Sangre
				Tooltip: "[c/fcd132:'...This lance shall end that festering, slothful dream!']"
				CurrentHardblood: "[c/c2003a:HARDBLOOD: {0}% ({1} / {2})]"
			}
		}

		Projectiles: {
			LaSangreProjectile.DisplayName: La Sangre
			AscendantProjectile.DisplayName: Ascendant La Sangre
		}

		UI.ExampleResource: Mods.LaSangreMod.UI.ExampleResource
